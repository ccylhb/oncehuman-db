---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import food from "../../data/oncehuman_food.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";
import { cl, pick, desc, stats, introSentence, best } from "../../lib/seo";

export function getStaticPaths() {
  return food.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const f = x.fields || {};
const similar = food
  .filter((o) => o.slug !== x.slug && (o.fields?.rarity || "") === (f.rarity || ""))
  .slice(0, 6);
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Food", item: SITE + "/food/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: SITE + "/food/" + __slug + "/",
  },
];

// SEO: lead with concrete stats; fall back to the scraped intro sentence.
const description =
  desc(
    `${x.title}:`,
    cl(f.rarity) && cl(f.type) && `${cl(f.rarity)} ${cl(f.type)} —`,
    stats(
      cl(f.status_energy) && `energy ${cl(f.status_energy)}`,
      cl(f.durability) && `shelf life ${cl(f.durability)}`,
      cl(f.stack_size) && `stacks to ${cl(f.stack_size)}`,
      cl(f.weight) && `weight ${cl(f.weight)}`
    ),
    "Once Human food stats and effects."
  ) || introSentence(x.intro);
---
<Base
  title={`${x.title} — Once Human food stats`}
  description={description}
>
  <h1>{x.title}</h1>
  {f.quote && <p class="muted">{f.quote}</p>}
  <EntryStats entry={x} keys={["status_energy", "status_hydration", "stack_size", "weight", "rarity", "type"]} labels={{ status_energy: "Energy", status_hydration: "Hydration", stack_size: "Stack size", weight: "Weight", rarity: "Rarity", type: "Type" }} />
  <p>
    {f.rarity && <span class="tag" style="margin:0.1rem">{f.rarity}</span>}
    {f.armor_type && <span class="tag" style="margin:0.1rem">{f.armor_type}</span>}
    {f.weapon_type && <span class="tag" style="margin:0.1rem">{f.weapon_type}</span>}
    {f.type && <span class="tag" style="margin:0.1rem">{f.type}</span>}
    {f.style && <span class="tag" style="margin:0.1rem">{f.style}</span>}
  </p>
  {f.armor_features && <p><strong>Features:</strong> {f.armor_features}</p>}
  {f.weapon_features && <p><strong>Features:</strong> {f.weapon_features}</p>}
  {ihtml && <p set:html={ihtml}></p>}
  <Related
    links={[
      ...similar.map((s) => ({
        href: `/food/${s.slug}/`,
        title: s.title,
      })),
      { href: "/food/", title: "All Food", sub: "Sortable table" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
