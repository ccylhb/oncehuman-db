---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import armor from "../../data/oncehuman_armor.json";

export function getStaticPaths() {
  return armor.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const f = x.fields || {};
const similar = armor
  .filter((o) => o.slug !== x.slug && (o.fields?.rarity || "") === (f.rarity || ""))
  .slice(0, 6);
---
<Base
  title={`${x.title} — Once Human armor stats`}
  description={`${x.title}: Once Human armor values — exact stats from the wiki infobox.`}
>
  <h1>{x.title}</h1>
  {f.quote && <p class="muted">{f.quote}</p>}
  <EntryStats entry={x} keys={["hp", "durability", "pollution_resist", "psi_intensity", "weight"]} labels={{ hp: "HP", durability: "Durability", pollution_resist: "Pollution resistance", psi_intensity: "Psi intensity", weight: "Weight" }} />
  <p>
    {f.rarity && <span class="tag" style="margin:0.1rem">{f.rarity}</span>}
    {f.armor_type && <span class="tag" style="margin:0.1rem">{f.armor_type}</span>}
    {f.weapon_type && <span class="tag" style="margin:0.1rem">{f.weapon_type}</span>}
    {f.type && <span class="tag" style="margin:0.1rem">{f.type}</span>}
    {f.style && <span class="tag" style="margin:0.1rem">{f.style}</span>}
  </p>
  {f.armor_features && <p><strong>Features:</strong> {f.armor_features}</p>}
  {f.weapon_features && <p><strong>Features:</strong> {f.weapon_features}</p>}
  {x.intro && <p>{x.intro}</p>}
  <Related
    links={[
      ...similar.map((s) => ({
        href: `/armor/${s.slug}/`,
        title: s.title,
      })),
      { href: "/armor/", title: "All Armor", sub: "Sortable table" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
</Base>
