---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import weapons from "../../data/oncehuman_weapons.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";
import { cl, pick, desc, stats, introSentence, best } from "../../lib/seo";

export function getStaticPaths() {
  return weapons.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const f = x.fields || {};
const similar = weapons
  .filter((o) => o.slug !== x.slug && (o.fields?.rarity || "") === (f.rarity || ""))
  .slice(0, 6);
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Weapons", item: SITE + "/weapons/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: SITE + "/weapons/" + __slug + "/",
  },
];

// SEO: lead with concrete stats; fall back to the scraped intro sentence.
const description =
  desc(
    `${x.title}:`,
    cl(f.rarity) && cl(f.weapon_type) && `${cl(f.rarity)} ${cl(f.weapon_type)}${f.style ? ` (${cl(f.style)})` : ""} —`,
    stats(
      cl(f.dmg) && `damage ${cl(f.dmg)}`,
      cl(f.fire_rate) && `fire rate ${cl(f.fire_rate)}`,
      cl(f.crit_rate) && `crit ${cl(f.crit_rate)}/${pick(f.crit_dmg) || "-"}`,
      cl(f.weakspot_dmg) && `weakspot ${cl(f.weakspot_dmg)}`,
      cl(f.magazine_capacity) && `magazine ${cl(f.magazine_capacity)}`,
      cl(f.durability) && `durability ${cl(f.durability)}`
    ),
    "Once Human weapon stats."
  ) || introSentence(x.intro);
---
<Base
  title={`${x.title} — Once Human weapons stats`}
  description={description}
>
  <h1>{x.title}</h1>
  {f.quote && <p class="muted">{f.quote}</p>}
  <EntryStats entry={x} keys={["dmg", "crit_rate", "crit_dmg", "weakspot_dmg", "fire_rate", "magazine_capacity", "durability", "weight"]} labels={{ dmg: "Damage", crit_rate: "Crit rate", crit_dmg: "Crit damage", weakspot_dmg: "Weakspot damage", fire_rate: "Fire rate", magazine_capacity: "Magazine", durability: "Durability", weight: "Weight" }} />
  <p>
    {f.rarity && <span class="tag" style="margin:0.1rem">{f.rarity}</span>}
    {f.armor_type && <span class="tag" style="margin:0.1rem">{f.armor_type}</span>}
    {f.weapon_type && <span class="tag" style="margin:0.1rem">{f.weapon_type}</span>}
    {f.type && <span class="tag" style="margin:0.1rem">{f.type}</span>}
    {f.style && <span class="tag" style="margin:0.1rem">{f.style}</span>}
  </p>
  {f.armor_features && <p><strong>Features:</strong> {f.armor_features}</p>}
  {f.weapon_features && <p><strong>Features:</strong> {f.weapon_features}</p>}
  {ihtml && <p set:html={ihtml}></p>}
  <Related
    links={[
      ...similar.map((s) => ({
        href: `/weapons/${s.slug}/`,
        title: s.title,
      })),
      { href: "/weapons/", title: "All Weapons", sub: "Sortable table" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
